{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prism-framework.org/schema/1.0/prism-mvp/bets",
  "title": "PRISM/MVP — B: Bets",
  "description": "What we're building: feature bets, exclusions, alternatives considered.",
  "type": "object",
  "required": ["prism"],
  "additionalProperties": false,
  "properties": {
    "prism": {
      "type": "object",
      "required": ["layer", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "layer": { "const": "bets" },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "temporal_state": { "type": "string", "enum": ["baseline", "transition", "target"] },
        "as_of": { "type": "string", "format": "date" },
        "label": { "type": "string" }
      }
    },
    "bets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tier", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tier": { "type": "string", "enum": ["must", "should", "could"] },
          "rationale": { "type": "string" },
          "description": { "type": "string" },
          "linked_hypothesis": { "type": "string" },
          "linked_value": { "type": "string" },
          "opportunity_cost": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "validated", "invalidated", "parked"] },
          "ai_specific": { "type": "boolean" },
          "prism_a_component": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "rationale": { "type": "string" },
          "description": { "type": "string" },
          "opportunity_cost": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "rationale": { "type": "string" },
          "description": { "type": "string" },
          "why_rejected": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
